# caelestia4: environment for the uwsm-managed Hyprland session ("Hyprland (uwsm-managed)" at login).
# Sourced by uwsm's preloader (POSIX sh) and exported to systemd + D-Bus, so apps started as units get it too.
# Mirrors ~/.config/hypr/hyprland/env.lua, which only applies to the plain (non-uwsm) Hyprland session.
# Machine-specific additions: ~/.config/uwsm/env-hyprland.d/*.sh (sourced after this file).

# Marker read by the Hyprland config (UWSM), the shell (AppLauncher) and scripts
export CAELESTIA4_UWSM=1

# Wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Applications (flatpak exports first)
# Duplicates and empty entries dropped, order kept: the default value already has the system dirs (end-4 PR #3712)
_c4_dirs=
_c4_ifs=$IFS
IFS=:
for _c4_dir in "$HOME/.local/share/flatpak/exports/share" /var/lib/flatpak/exports/share /usr/local/share /usr/share $XDG_DATA_DIRS; do
    if [ -n "$_c4_dir" ]; then
        case ":$_c4_dirs:" in
            *":$_c4_dir:"*) ;;
            *) _c4_dirs="${_c4_dirs:+$_c4_dirs:}$_c4_dir" ;;
        esac
    fi
done
IFS=$_c4_ifs
export XDG_DATA_DIRS="$_c4_dirs"
unset _c4_dirs _c4_ifs _c4_dir

# Themes
export QT_QPA_PLATFORM="wayland;xcb"
# Qt apps: Caelestia's platform theme (caelestia4-qtengine; caelestia-cli writes its colours and config, cli.json
# enableQt). Was Plasma's (kde), which goes with Plasma
export QT_QPA_PLATFORMTHEME=qtengine
# Application menu for KDE apps' "Open with" (kbuildsycoca): archlinux-xdg-menu's arch-applications.menu (Plasma's
# plasma-applications.menu goes with Plasma)
export XDG_MENU_PREFIX=arch-

# end-4 Python virtual environment
export ILLOGICAL_IMPULSE_VIRTUAL_ENV="$HOME/.local/state/quickshell/.venv"

# User-local Caelestia QML plugin (caelestia4-quickshell)
export QML_IMPORT_PATH="$HOME/.local/lib/qt6/qml"

pragma Singleton
pragma ComponentBehavior: Bound

// caelestia4 ADAPTER: Colours
// Caelestia's colour logic is kept (transparency layers, tPalette, blur layer rules, wallpaper luminance).
// Backend step 3: the palette is caelestia-cli's scheme.json again (all roles + term0-15), as upstream; caelestia-cli
// makes it from the wallpaper or a preset and its postHook (utils/scripts/scheme.py bridge) passes it to end-4, so both
// halves of the shell show the same colours. Without caelestia-cli, apptheme.py writes scheme.json from end-4's colours.
// Contract used by Caelestia UI: palette, tPalette, layer(), on(), light, transparency{enabled,base,layers},
// scheme, flavour, schemes, setScheme(), setMode(), showPreview, load(), loadPreview(), wallLuminance.
// Colour preview while browsing wallpapers: Wallpapers.preview() runs `caelestia wallpaper -p` (or wallpreview.sh's
// matugen dry run without caelestia-cli) and fills `preview`; nothing is applied until a wallpaper is picked.

import QtQuick
import Quickshell
import Quickshell.Io
import Caelestia.Config
import Caelestia.Images
import qs.services as E4 // caelestia4: keep
import qs.modules.common as E4C // caelestia4: keep
import qs.modules.caelestia.adapters
import qs.modules.caelestia.utils

Singleton {
    id: root

    property bool showPreview
    property string scheme: "dynamic"
    property string flavour
    // Preset schemes: [{ name, flavour, modes: { dark?: {role: "rrggbb"}, light?: {...} } }], sorted by name
    property var schemes: []
    readonly property string schemeScript: Quickshell.shellPath("modules/caelestia/utils/scripts/scheme.py")

    // Use a preset scheme (in the current light/dark mode when it has one) or "dynamic" for wallpaper colours
    function setScheme(name: string, flavour: string): void {
        const mode = root.currentLight ? "light" : "dark";
        root.scheme = name;
        root.flavour = name === "dynamic" ? "" : flavour;
        Quickshell.execDetached(name === "dynamic" ? [root.schemeScript, "set", "dynamic", "--mode", mode] : [root.schemeScript, "set", name, flavour, "--mode", mode]);
    }

    function reloadSchemes(): void {
        schemeListProc.running = true;
    }
    readonly property bool light: showPreview ? previewLight : currentLight
    property bool currentLight
    property bool previewLight
    readonly property M3Palette palette: showPreview ? preview : current
    readonly property M3TPalette tPalette: M3TPalette {}
    readonly property M3Palette current: M3Palette {}
    readonly property M3Palette preview: M3Palette {}

    // caelestia-cli's scheme JSON (scheme.json, `caelestia wallpaper -p`), upstream's Colours.load()
    function load(data: string, isPreview: bool): void {
        const colours = isPreview ? preview : current;
        const scheme = JSON.parse(data);

        if (!isPreview) {
            root.scheme = scheme.name;
            flavour = scheme.flavour;
            currentLight = scheme.mode === "light";
        } else {
            previewLight = scheme.mode === "light";
        }

        for (const [name, colour] of Object.entries(scheme.colours)) {
            const propName = name.startsWith("term") ? name : `m3${name}`;
            if (colours.hasOwnProperty(propName))
                colours[propName] = `#${colour}`;
        }
    }

    // Without caelestia-cli: fill `preview` from wallpreview.sh's matugen JSON (colors.<snake_case role>.default.color). Roles matugen doesn't make
    // (success, terminal colours) come from the current palette; key colours follow their roles, as in `current`.
    function loadPreview(json: string, light: bool): void {
        const roles = JSON.parse(json).colors ?? {};
        const p = root.preview;
        for (const key of ["m3success", "m3onSuccess", "m3successContainer", "m3onSuccessContainer"])
            p[key] = root.current[key];
        for (let i = 0; i < 16; i++)
            p[`term${i}`] = root.current[`term${i}`];
        for (const [role, value] of Object.entries(roles)) {
            const prop = "m3" + role.replace(/_([a-z])/g, (_, c) => c.toUpperCase());
            if (prop in p && value?.default?.color)
                p[prop] = value.default.color;
        }
        for (const [key, role] of [["primary", "primary"], ["secondary", "secondary"], ["tertiary", "tertiary"], ["neutral", "surface"], ["neutral_variant", "outlineVariant"]])
            p[`m3${key}_paletteKeyColor`] = p[`m3${role}`];
        root.previewLight = light;
    }
    readonly property Transparency transparency: Transparency {}
    readonly property alias wallLuminance: analyser.luminance

    property bool cooldownPending
    property real lastBaseTransparency

    function getLuminance(c: color): real {
        if (c.r == 0 && c.g == 0 && c.b == 0)
            return 0;
        return Math.sqrt(0.299 * (c.r ** 2) + 0.587 * (c.g ** 2) + 0.114 * (c.b ** 2));
    }

    function alterColour(c: color, a: real, layer: int): color {
        const luminance = getLuminance(c);

        const offset = (!light || layer == 1 ? 1 : -layer / 2) * (light ? 0.2 : 0.3) * (1 - transparency.base) * (1 + wallLuminance * (light ? (layer == 1 ? 3 : 1) : 2.5));
        const scale = (luminance + offset) / luminance;
        const r = Math.max(0, Math.min(1, c.r * scale));
        const g = Math.max(0, Math.min(1, c.g * scale));
        const b = Math.max(0, Math.min(1, c.b * scale));

        return Qt.rgba(r, g, b, a);
    }

    function layer(c: color, layer: var): color {
        if (!transparency.enabled)
            return c;

        return layer === 0 ? Qt.alpha(c, transparency.base) : alterColour(c, transparency.layers, layer ?? 1);
    }

    function on(c: color): color {
        if (c.hslLightness < 0.5)
            return Qt.hsla(c.hslHue, c.hslSaturation, 0.9, 1);
        return Qt.hsla(c.hslHue, c.hslSaturation, 0.1, 1);
    }

    function setMode(mode: string): void {
        if (root.cliAvailable) // caelestia-cli: same scheme in the other mode (a preset may switch flavour)
            Quickshell.execDetached([root.schemeScript, "mode", mode]);
        else // end-4: regenerate its scheme from the current wallpaper in the requested mode
            E4.Wallpapers.apply(E4C.Config.options.background.wallpaperPath, mode === "dark");
    }

    // caelestia-cli installed (backend step 3); without it colours come from end-4's matugen pipeline
    property bool cliAvailable: true

    Process {
        running: true
        command: ["sh", "-c", "command -v caelestia"]
        onExited: code => root.cliAvailable = code === 0
    }

    function reloadHyprRules(): void {
        let rule, trEnabled;
        if (Hypr.usingLua) {
            rule = `eval hl.layer_rule({ match = { namespace = "caelestia-drawers" }, %1 = %2 })`;
            trEnabled = transparency.enabled;
        } else {
            rule = "keyword layerrule %1 %2, match:namespace caelestia-drawers";
            trEnabled = transparency.enabled ? 1 : 0;
        }
        Hypr.extras.batchMessage([rule.arg("blur").arg(trEnabled), rule.arg("ignore_alpha").arg(Math.max(0, transparency.base - 0.03))]);
    }

    function requestReloadHyprRules(): void {
        if (cooldownTimer.running) {
            root.cooldownPending = true;
        } else {
            root.reloadHyprRules();
            cooldownTimer.restart();
        }
    }

    Component.onCompleted: root.requestReloadHyprRules()

    Process {
        id: schemeListProc

        running: true
        command: [root.schemeScript, "list"]
        stdout: StdioCollector {
            onStreamFinished: {
                const data = JSON.parse(text || "{}");
                const flat = [];
                for (const [name, flavours] of Object.entries(data))
                    for (const [flavour, modes] of Object.entries(flavours))
                        flat.push({
                            name,
                            flavour,
                            modes
                        });
                root.schemes = flat;
            }
        }
    }

    FileView {
        path: `${Paths.state}/scheme.json`
        watchChanges: true
        onFileChanged: reload()
        onLoaded: root.load(text(), false)
    }

    Connections {
        function onConfigReloaded(): void {
            root.reloadHyprRules();
        }

        target: Hypr
    }


    ImageAnalyser {
        id: analyser

        source: Wallpapers.current
    }

    Timer {
        id: cooldownTimer

        interval: 30
        onTriggered: {
            if (root.cooldownPending) {
                root.cooldownPending = false;
                root.reloadHyprRules();
                restart();
            }
        }
    }

    Timer {
        id: cAnimCompleteTimer

        interval: Tokens.anim.durations.expressiveSlowEffects
        onTriggered: root.requestReloadHyprRules()
    }

    component Transparency: QtObject {
        readonly property bool enabled: Tokens.transparency.enabled
        readonly property real base: Math.max(0, Math.min(1, Tokens.transparency.base - (root.light ? 0.1 : 0)))
        readonly property real layers: Math.max(0, Math.min(1, Tokens.transparency.layers))

        onEnabledChanged: {
            if (enabled)
                root.requestReloadHyprRules();
            else
                cAnimCompleteTimer.start();
        }
        onBaseChanged: {
            if (root.lastBaseTransparency > base)
                root.requestReloadHyprRules();
            else
                cAnimCompleteTimer.start();
            root.lastBaseTransparency = base;
        }
    }

    component M3TPalette: QtObject {

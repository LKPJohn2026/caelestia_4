# caelestia4: defaults for the Hyprland session only (XDG_CURRENT_DESKTOP=Hyprland:KDE, so this file wins over
# mimeapps.list there; Plasma keeps its own). Folders open in Atlas (caelestia4-atlas package), else Thunar. Installed by tools/install-main.sh, merged into an existing file.
[Default Applications]
inode/directory=atlas.desktop;thunar.desktop

# caelestia4: the shell (Quickshell, config "ii") as a user service in the uwsm Hyprland session.
# Restart: systemctl --user restart caelestia4-shell (Ctrl+Super+R). Logs: journalctl --user -u caelestia4-shell -f
# Apps launched from the shell are handed to uwsm (own units), so restarting the shell doesn't close them.
[Unit]
Description=Caelestia 4 shell (Quickshell)
PartOf=graphical-session.target
ConditionEnvironment=CAELESTIA4_UWSM=1
# caelestia4: kded6 (KDE daemon) first. Its status-notifier watcher holds the system tray registrations, and it
# outlives shell restarts, so tray icons survive them (Electron apps like Claude never re-register). Started late
# (by a KDE app) it used to take the watcher over mid-session and drop the icons registered with the shell.
Wants=plasma-kded6.service
After=graphical-session.target plasma-kded6.service

[Service]
Type=exec
ExecStart=/usr/bin/qs -c ii
Restart=on-failure
RestartSec=1
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target

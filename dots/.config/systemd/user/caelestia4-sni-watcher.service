# caelestia4: the system tray registry (org.kde.StatusNotifierWatcher), started before the shell and outliving its
# restarts, so tray icons survive them (scripts/caelestia4/sni-watcher.py). Replaces kded6's module, which is part of
# plasma-workspace.
[Unit]
Description=Caelestia 4 system tray watcher (StatusNotifierWatcher)
PartOf=graphical-session.target
ConditionEnvironment=CAELESTIA4_UWSM=1
After=graphical-session-pre.target
Before=caelestia4-shell.service

[Service]
Type=dbus
BusName=org.kde.StatusNotifierWatcher
ExecStart=/usr/bin/python3 %h/.config/quickshell/ii/scripts/caelestia4/sni-watcher.py
Restart=on-failure
RestartSec=1
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target

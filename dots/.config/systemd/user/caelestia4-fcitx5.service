# caelestia4: fcitx5 input method (Bamboo) in the uwsm Hyprland session. Plasma starts it itself (KWin InputMethod).
[Unit]
Description=Fcitx5 input method
PartOf=graphical-session.target
ConditionEnvironment=CAELESTIA4_UWSM=1
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/fcitx5 --replace
Restart=on-failure
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target

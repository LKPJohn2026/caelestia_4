# caelestia_4: Atlas (AstraSuite), the Material 3 file manager built on Caelestia's design tokens. Pinned to one
# verified revision. The Hyprland session opens folders with it (dots/.config/hyprland-mimeapps.list); Thunar stays
# installed as the fallback. Colours follow Caelestia through ~/.local/state/caelestia/scheme.json.

_pkgname=atlas
_commit=f93ebc2863300f99ba807a523d708d279dcc8b0b # v1.3.1
pkgname=caelestia4-atlas
pkgver=1.3.1
pkgrel=1
pkgdesc='Atlas file manager pinned for caelestia_4'
arch=(x86_64)
url='https://github.com/AstraSuite/Atlas'
license=('GPL-3.0-only')
depends=(qt6-base qt6-declarative qt6-svg qt6-multimedia exiv2)
makedepends=(cmake ninja git)
optdepends=('udisks2: external drives (mount, unmount)'
            'gvfs: network locations (SFTP, SMB, FTP, NFS, WebDAV)'
            'xdg-utils: open files with their default application'
            'ffmpeg: video and audio tools'
            'imagemagick: image conversion'
            'p7zip: 7z archives'
            'unzip: zip archives'
            'zip: zip compression'
            'caelestia-cli: Caelestia colour sync'
            'papirus-icon-theme: folder colours')
provides=("$_pkgname")
conflicts=("$_pkgname" "$_pkgname-git")
source=("$_pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cd "$_pkgname"
  cmake -GNinja -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DATLAS_VERSION="$pkgver"
  cmake --build build
}

package() {
  cd "$_pkgname"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

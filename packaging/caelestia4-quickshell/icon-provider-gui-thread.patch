+QQuickImageResponse*
+IconImageProvider::requestImageResponse(const QString& id, const QSize& requestedSize) {
+	// caelestia4: made here in the image thread, answered on the GUI thread (see the header). The response lives on the
+	// GUI thread, so the queued call is dropped if it is deleted first (a cancelled request, the engine going away)
+	auto* response = new IconImageResponse();
+	response->moveToThread(QCoreApplication::instance()->thread());
+
+	QMetaObject::invokeMethod(
+	    response,
+	    [response, id, requestedSize]() {
+		    response->image = IconImageProvider::renderIcon(id, nullptr, requestedSize).toImage();
+		    emit response->finished();
+	    },
+	    Qt::QueuedConnection
+	);
+
+	return response;
+}
+
+QQuickTextureFactory* IconImageResponse::textureFactory() const {
+	return QQuickTextureFactory::textureFactoryForImage(this->image);
+}

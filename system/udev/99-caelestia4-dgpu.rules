# caelestia4: stable name for an NVIDIA GPU, on a machine with another GPU too and its monitors on the NVIDIA one.
# Not for a laptop whose panel is on the iGPU, nor needed with one GPU. With two NVIDIA GPUs, match
# KERNELS=="0000:01:00.0" (see lspci) instead of the vendor.
# /dev/dri/cardN numbering can swap between boots; AQ_DRM_DEVICES uses ':' as a separator, so the
# by-path name (which contains ':') can't be used there. This gives /dev/dri/nvidia-dgpu instead.
# Install:  sudo install -m644 system/udev/99-caelestia4-dgpu.rules /etc/udev/rules.d/
#           sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=drm
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{vendor}=="0x10de", SYMLINK+="dri/nvidia-dgpu"

# caelestia4: Ollama as the user (not the packaged system service). To share LM Studio's GGUFs without a second copy
# (tools/ollama-import-lmstudio.sh hard-links them), keep the model store on the same drive: change OLLAMA_MODELS.
[Unit]
Description=Ollama (user)
After=network-online.target local-fs.target

[Service]
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_MODELS=%h/.ollama/models
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_FLASH_ATTENTION=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

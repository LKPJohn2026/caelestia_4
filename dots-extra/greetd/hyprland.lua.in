-- caelestia4: Hyprland as the login screen's compositor (greetd runs it as "greeter": /etc/greetd/config.toml).
-- Generated by tools/greetd-setup.sh: the monitors come from ~/.config/hypr/monitors.lua, the colour from the scheme.
-- ReGreet runs in it; once it has started the session (or quits), Hyprland exits and greetd starts the session.

@MONITORS@

hl.config({
    misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        disable_autoreload = true,
        background_color = "0xff@BACKGROUND@",
    },
    ecosystem = {
        no_update_news = true,
        no_donation_nag = true,
    },
    animations = {
        enabled = false,
    },
    input = {
        kb_layout = "@KB_LAYOUT@",
    },
})

hl.env("XCURSOR_THEME", "Bibata-Modern-Classic")
hl.env("XCURSOR_SIZE", "24")
-- No portals for ReGreet (GTK 4): the greeter user has no portals config, and GTK asking for them started
-- xdg-desktop-portal(-hyprland) and wormhole as "greeter", which crashed at each login (coredumps, UID 948)
hl.env("GDK_DEBUG", "no-portals")

hl.on("hyprland.start", function()
    hl.exec_cmd("regreet; hyprctl dispatch 'hl.dsp.exit()'")
end)

#%PAM-1.0
# caelestia4: greetd's PAM stack (/etc/pam.d/greetd, by tools/greetd-setup.sh): greetd's own + gnome-keyring, which
# creates and unlocks the login keyring with the login password ("-": skipped when the module isn't installed).
# KWallet's lines went with Plasma (its keys are in gnome-keyring: docs/dev/kde-removal.md).
auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
-auth      optional     pam_gnome_keyring.so
account    include      system-local-login
password   include      system-local-login
-password  optional     pam_gnome_keyring.so    use_authtok
session    optional     pam_keyinit.so          force revoke
session    include      system-local-login
-session   optional     pam_gnome_keyring.so    auto_start
